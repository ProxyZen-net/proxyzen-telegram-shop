# Telegram-бот от @BotFather / bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# Telegram ID администраторов через запятую (узнать: @userinfobot)
# Admin Telegram IDs, comma-separated (get yours from @userinfobot)
ADMIN_IDS=123456789

# API-ключ ProxyZen (кабинет proxyzen.net → API). Можно задать позже в /admin.
# ProxyZen API key (proxyzen.net dashboard → API). Can also be set later in /admin.
PROXYZEN_API_KEY=

# Язык бота для новых пользователей: en, ru или auto (по языку Telegram). Пользователь меняет его в профиле.
# Bot language for new users: en, ru or auto (by Telegram language). Users can switch it in their profile.
DEFAULT_LANG=en

# Файл базы данных / database file
DB_PATH=data/bot.db
